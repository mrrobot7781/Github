IPTABLES
==========

Sudo systemctl disable --now firewalld

Sudo systemctl mask firewalld

Sudo yum install iptables-services  iptables-utils -y
 
ip -br a

sudo systemctl reload iptables 

echo 1 | sudo tee /proc/sys/net/ipv4/ip_forward

sudo vi /etc/sysctl.conf

sudo iptables -t nat -A POSTROUTING -s 192.168.35.0/24 -o ens160 -j MASQUERADE 

sudo iptables -I FORWARD 1 -p udp -s 192.168.35.0/24 -d 192.168.72.20 --dport=53 -j ACCEPT

sudo iptables -I FORWARD 1 -p udp -d 192.168.35.0/24 -s 192.168.72.20 --sport=53 -j ACCEPT

CDAC chain

sudo iptables -N cdac

sudo iptables -I FORWARD 3 -j cdac

sudo iptables -A cdac -p tcp -s 192.168.35.0/24 -d www.google.com --dport=443 -m conntrack --ctstate NEW -j ACCEPT 

sudo iptables -A cdac -p tcp -m conntrack --ctstate RELATED,ESTABLISHED  -j ACCEPT 

sudo iptables -A cdac -p tcp -s 192.168.35.0/24 -d www.redhat.com --dport=443 -m conntrack --ctstate NEW -j ACCEPT 

sudo iptables -A cdac -j RETURN

sudo iptables -I cdac 1 -p tcp -s 192.168.35.0/24 -d 34.235.198.240 --dport=443 -m conntrack --ctstate NEW -j ACCEPT 

sudo iptables -D FORWARD 4


